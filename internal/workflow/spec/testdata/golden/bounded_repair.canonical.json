{"apiVersion":"yaah.workflow/v1","kind":"Workflow","metadata":{"name":"bounded-repair","version":"1.0.0"},"spec":{"budgets":{"max_concurrent_dispatches":1,"max_dispatches":12,"max_wall_clock_seconds":1800},"defaults":{"grants":[{"access":"readwrite","path":"src"}],"lane":"proposal","network":"deny_all"},"params":{"task":{"required":true,"type":"string"}},"steps":[{"id":"implement","kind":"delegate","output":{"name":"proposal"},"prompt":"Implement this task and return a retained proposal: {{ params.task }}\nOnly touch paths under src/.\n","role":"developer"},{"body":[{"id":"fix","kind":"delegate","output":{"name":"fix_proposal"},"prompt":"The checks failed. Repair the proposal\n{{ steps.implement.output.proposal_id }} so the verification passes.\n","role":"developer"},{"id":"check","kind":"delegate","lane":"report","output":{"name":"Verdict"},"prompt":"Run /app/verify.py against the repaired proposal.\nDiff: {{ steps.fix.output.diff }}\nReturn JSON: {\"verdict\":\"pass\"|\"fail\",\"reasons\":[]}.\n","role":"tester","timeout_seconds":300}],"collect":"outcomes","continue_from":"{{ steps.implement.output.proposal_id }}","id":"repair","kind":"loop","max_iterations":3,"needs":["implement"],"on_failure":"continue","until":{"equals":"pass","field":"verdict","from":"steps.repair.collect"}},{"action":"apply","id":"land","kind":"settle","needs":["repair"],"on_conflict":"escalate","on_empty":"fail","policy":"three_way","proposals":{"from":"steps.repair.collect"},"where":{"equals":"pass","field":"verdict","from":"steps.repair.collect"}},{"id":"report","kind":"emit","needs":["land"],"path":"artifacts/repair-report.md","value":"Repaired through {{ steps.repair.collect }}; landed {{ steps.land.output.settled }} proposal(s).\n"}]}}