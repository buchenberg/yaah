{"apiVersion":"yaah.workflow/v1","kind":"Workflow","metadata":{"name":"feature-review","version":"1.0.0"},"spec":{"budgets":{"max_concurrent_dispatches":4,"max_dispatches":24,"max_wall_clock_seconds":3600},"defaults":{"grants":[{"access":"readwrite","path":"src"},{"access":"readonly","path":"docs"}],"lane":"proposal","network":"deny_all"},"params":{"max_workstreams":{"default":4,"type":"integer"},"task":{"required":true,"type":"string"}},"steps":[{"id":"plan","kind":"delegate","lane":"report","output":{"name":"Plan"},"prompt":"Break \"{{ params.task }}\" into at most {{ params.max_workstreams }}\nindependent workstreams that touch disjoint paths.\nReturn JSON: {\"workstreams\":[{\"id\",\"brief\",\"paths\"}]}.\n","retry":{"backoff_seconds":1.5,"max_attempts":2},"role":"planner"},{"as":"ws","body":[{"kind":"delegate","output":{"name":"proposal"},"prompt":"Implement this workstream: {{ ws.brief }}\nOnly touch these paths: {{ ws.paths }}.\n","role":"developer"}],"collect":"proposals","id":"build","join":"all","kind":"fanout","max_parallel":4,"on_item_failure":"continue","over":{"from":"steps.plan.output.workstreams"}},{"as":"proposal","body":[{"kind":"delegate","lane":"report","output":{"name":"Verdict"},"prompt":"Review this proposal for correctness. Proposal id: {{ proposal.id }}\nDiff: {{ proposal.diff }}\nReturn JSON: {\"verdict\":\"pass\"|\"fail\",\"reasons\":[]}.\n","role":"reviewer"}],"collect":"reviews","id":"review","join":"all","kind":"fanout","max_parallel":4,"on_item_failure":"continue","over":{"from":"steps.build.collect"}},{"action":"apply","id":"land","kind":"settle","on_conflict":"stop","on_empty":"skip","order":"smallest_diff_first","policy":"path_disjoint","proposals":{"from":"steps.build.collect"},"where":{"equals":"pass","field":"verdict","from":"steps.review.collect"}},{"id":"report","kind":"emit","value":"Landed {{ steps.land.output.settled }} proposal(s).\n"}]}}